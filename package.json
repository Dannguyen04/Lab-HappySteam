{
  "name": "lab-happysteam",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tests/run-suite.js logic && vitest run",
    "check:lessons": "node scripts/check-lessons.js",
    "test:smoke": "node tests/run-suite.js smoke",
    "test:all": "npm run test && npm run test:smoke",
    "test:dist": "npm run build && node tests/run-dist.js",
    "typecheck": "tsc --noEmit",
    "gen:seed": "node scripts/gen-lessons-seed.js"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-static-copy": "^2.3.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "blockly": "^13.4.0",
    "three": "^0.187.0"
  }
}
